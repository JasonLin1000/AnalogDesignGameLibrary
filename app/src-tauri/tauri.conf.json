{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Analog Design Lab",
  "version": "0.5.0",
  "identifier": "org.analogdesigngame.lab",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "Analog Design Lab", "width": 1440, "height": 900, "minWidth": 1024, "minHeight": 640 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
