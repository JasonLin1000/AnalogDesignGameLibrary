{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Analog Design Lab",
  "version": "0.6.0",
  "identifier": "org.analogdesigngame.lab",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "類比設計實驗室 Analog Design Lab", "width": 1440, "height": 900, "minWidth": 1024, "minHeight": 640, "center": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Analog Design Game Library",
    "copyright": "Apache-2.0",
    "category": "Education",
    "shortDescription": "類比電路設計學習遊戲 / Analog circuit design learning game",
    "longDescription": "An open-source bilingual game for learning analog IC design on the SKY130 PDK, with a built-in ngspice simulator.",
    "licenseFile": "../../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "both",
        "languages": ["TradChinese", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "startMenuFolder": "Analog Design Lab"
      }
    }
  }
}
